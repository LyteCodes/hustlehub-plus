PORT=3000
NODE_ENV=development
JWT_SECRET= # <generate with: openssl rand -hex 32>
USE_HTTPS=true
SSL_KEY_PATH="secrets/localhost-key.pem"
SSL_CERT_PATH="secrets/localhost-cert.pem"
CLIENT_ORIGIN="http://localhost:5173"
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hustlehub
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
BOOKING_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=300
