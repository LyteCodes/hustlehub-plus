{
  "name": "hustlehub-plus_backend",
  "version": "1.0.0",
  "description": "The backend API for HustleHub+",
  "keywords": [
    "MERN"
  ],
  "author": "Sky Martin, Lyle William Richardson, James Marshall, Connaire Myall",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "init": "node scripts/init.js",
    "predev": "npm run init",
    "pretest": "npm run init",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "AUTH_RATE_LIMIT=100 node --test --test-force-exit tests/unit/*.test.js tests/integration/*.test.js",
    "test:jest": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "demo": "node scripts/demo.js",
    "test:postman:bookings": "newman run tests/postman/HustleHub-Auth.postman_collection.json -e tests/postman/HustleHub-Local.postman_environment.json --folder \"Bookings\" --insecure"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "mongoose-beautiful-unique-validation": "^7.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
