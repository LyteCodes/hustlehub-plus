{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Grafana Cloud Loki data source",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "HustleHub+ API – structured JSON logs and security audit events",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "All logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{service_name=\"hustlehub-plus-api\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Errors / minute",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqpm"
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({service_name=\"hustlehub-plus-api\"} | json | level=\"error\" [1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Failed logins / 5 min",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"hustlehub-plus-api\"} | json | event=\"auth.login.failed\" [5m]))",
          "legendFormat": "failed logins",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Rate-limited requests / 5 min",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"hustlehub-plus-api\"} | json | event=\"security.rate_limited\" [5m]))",
          "legendFormat": "rate-limited",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Security events",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"hustlehub-plus-api\"} | json | event =~ `security\\..*|auth\\.login\\.failed`",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Auth audit events",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"hustlehub-plus-api\"} | json | event =~ `auth\\..*`",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Business events (bookings & transactions)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"hustlehub-plus-api\"} | json | event =~ `booking\\..*|transaction\\..*`",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "Errors – last 1 h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"hustlehub-plus-api\"} | json | level=\"error\" [1h]))",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Failed logins – last 1 h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"hustlehub-plus-api\"} | json | event=\"auth.login.failed\" [1h]))",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Bookings – last 1 h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"hustlehub-plus-api\"} | json | event=\"booking.created\" [1h]))",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hustlehub", "api", "security"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "Africa/Johannesburg",
  "title": "HustleHub+ API Logs",
  "uid": "hustlehub-api-logs",
  "version": 1
}
